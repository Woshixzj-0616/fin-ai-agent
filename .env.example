# FinScope V5.2.0 模型配置示例。
# 本文件不会被程序自动读取：可复制为 .env 后自行导出，或在系统环境变量中设置。
# 通过网页“更换 API 密钥”填写的密钥只保存在当前服务进程，优先级更高。

# 工作台（agent）使用 LLM_* 变量
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FORMAT=json_object
# LLM_STREAM=1

# 六模块引擎单独运行时使用 DEEPSEEK_* 变量；也可写入 six_module_engine/.env
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 仅监听 127.0.0.1 时不需要；如需局域网访问，请设置访问密码
# APP_ACCESS_PASSWORD=

# 修改服务端口（默认 8769）
# PORT=8769
