+def _disclosure_review_status(result: dict[str, Any]) -> str:
+    """Keep open source/coverage checks visible without implying expert conclusions are proven."""
+    quality = result.get("run_quality") if isinstance(result.get("run_quality"), dict) else {}
+    if quality.get("critical_gaps") or result.get("quality_flags"):
+        return "open_items"
+    counts = quality.get("quote_verification_counts") if isinstance(quality.get("quote_verification_counts"), dict) else {}
+    if int(counts.get("quote_not_found") or 0) or int(counts.get("other_unverified") or 0):
+        return "open_items"
+    audit = result.get("audit_profile") if isinstance(result.get("audit_profile"), dict) else {}
+    if audit.get("opinion_verification_status") != "opinion_excerpt_and_type_verified":
+        return "open_items"
+    if any(item.get("evidence_status") not in {"verified_quote"} for item in result.get("findings", []) if isinstance(item, dict)):
+        return "open_items"
+    if any(
+        item.get("status") in {"confirmed_present", "explicit_no_disclosure"}
+        and item.get("verification_status") != "topic_and_quote_verified"
+        for item in result.get("coverage", []) if isinstance(item, dict)
+    ):
+        return "open_items"
+    if any(item.get("status") in {"searched_no_hit", "not_checked"} for item in result.get("coverage", []) if isinstance(item, dict)):
+        return "open_items"
+    if any(item.get("evidence_status") in {"linked_finding_reference_only", "direct_reference_unverified", "missing_reference"} for item in result.get("impacts", []) if isinstance(item, dict)):
+        return "open_items"
+    return "professional_review"
+
+
+def _checkpoint_result(module_recorder: RunRecorder, reason: str) -> dict[str, Any] | None:
+    checkpoint_path = module_recorder.artifacts_dir / "disclosure_checkpoint.json"
+    if not checkpoint_path.is_file():
+        return None
+    try:
+        checkpoint = json.loads(checkpoint_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return None
+    if not isinstance(checkpoint, dict):
+        return None
+    return partial_result_from_checkpoint(checkpoint, reason)
+
